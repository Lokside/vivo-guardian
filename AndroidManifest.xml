<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.phili.notifguard">

    <!-- Every app is watched: they must be "visible" to read their state and wake them up. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Chinese standard (vivo, Xiaomi, OPPO...): without it, the list only contains system apps. -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- Status screen: unblocking log + access to the accessibility setting.
             Never in recent apps. Protection against "Clear all" comes from the vivo lock put once on
             the app (see LockActivity). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The only screen shown in recent apps, long enough to put the vivo lock on once. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.phili.notifguard.lock" />

        <!-- Accessibility service: kept alive by Android, it unblocks the watched apps
             as soon as vivo force-stops them. -->
        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_service" />
        </service>
    </application>
</manifest>
