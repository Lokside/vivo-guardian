<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.phili.notifguard">

    <!-- Every app is watched: they must be "visible" to read their state and wake them up. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Chinese standard (vivo, Xiaomi, OPPO...): without it, the list only contains system apps. -->
    <uses-permission android:name="com.android.permission.GET_INSTALLED_APPS" />
    <!-- Optional "usage access": only used to know whether the Settings app is on screen when an app
         is stopped, so that a "Force stop" made by the user is respected. Off unless granted. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@android:style/Theme.DeviceDefault.Light.NoActionBar"
        android:allowBackup="false">

        <!-- Status screen: unblocking log + access to the notification access setting.
             Never in recent apps. Protection against "Clear all" comes from the vivo lock put once on
             the app (see LockActivity). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The only screen shown in recent apps, long enough to put the vivo lock on once. -->
        <activity
            android:name=".LockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="com.phili.notifguard.lock" />

        <!-- Notification listener used ONLY as a keep-alive anchor (Android keeps an enabled listener
             bound): it unblocks the watched apps as soon as vivo force-stops them.
             This is deliberately not an accessibility service: banking apps refuse to run next to
             third-party accessibility services.
             Every notification type is declared disabled, so the system delivers no notification to
             this listener (and the user cannot turn them on): the app reads no notification. -->
        <service
            android:name=".GuardService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.disabled_filter_types"
                android:value="conversations|alerting|silent|ongoing" />
        </service>
    </application>
</manifest>
